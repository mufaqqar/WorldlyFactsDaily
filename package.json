{
  "name": "remotion-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion showcase intro video",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render MufaqarIntro out/mufaqar-intro.mp4",
    "build:showcase": "remotion render ShowcaseIntro out/showcase-intro.mp4",
    "build:vertical": "remotion render MufaqarVertical out/mufaqar-vertical.mp4",
    "build:countries": "remotion render RichestCountries out/richest-countries-1960-2024.mp4",
    "build:steel": "remotion render SteelProducers out/steel-producers.mp4",
    "still": "remotion still MufaqarIntro out/mufaqar-poster.png --frame=60",
    "still:showcase": "remotion still ShowcaseIntro out/poster.png --frame=60",
    "still:vertical": "remotion still MufaqarVertical out/mufaqar-vertical-poster.png --frame=140",
    "still:countries": "remotion still RichestCountries out/richest-countries-poster.png --frame=1330",
    "still:steel": "remotion still SteelProducers out/steel-producers-poster.png --frame=950",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
